# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# API-ключ админки (Bearer). Лучше CASHER_API_KEY — надёжнее в production
CASHER_API_KEY=csh_at_...
# api=csh_at_...

# API заказов / каталога (Amarix)
ORDERS_API_URL=https://api.amarix.ru

# Внешний API товаров (картинки, размеры) — обычно тот же хост
PRODUCTS_API_URL=https://api.amarix.ru

# Токены админки по брендам (Bearer csh_at_…). Один токен = один бренд.
# ORDERS_API_TOKEN_CASHER=csh_at_...
# ORDERS_API_TOKEN_SHECASH=csh_at_...
# ORDERS_API_TOKEN_AMMO=csh_at_...
# ORDERS_API_TOKEN_KURAZHDVIZH=csh_at_...

# Опционально: ключи производственных площадок (hex). Если заданы —
# очередь/приход/каталог идут в /production-api/*, иначе в /products/production и /products.
# PRODUCTION_API_TOKEN_CASHER=...
# PRODUCTION_API_TOKEN_AMMO=...

# TTL кэша товаров на сервере, мс (5 мин)
PRODUCTS_CACHE_TTL_MS=300000

# Картинки отдаются через /api/images/... (прокси с PRODUCTS_API_URL, без локальной скачки)

# Куда пересылать события сборки/отправки (оставьте пустым — только локальный лог)
# SYNC_API_URL=https://your-backend.example.com

# Папка для кэша и логов синхронизации (на Debian задаётся deploy.sh)
# DATA_DIR=/opt/otpravki/data

# Опционально: принудительно указать принтер (иначе берётся TSC_TE300)
# BARCODE_PRINTER=TSC_TE300

# Записки / смайлики / честные знаки (SATO WS408, этикетка 60×55)
# GIFT_NOTE_PRINTER=WS408-SEPL

# Размер этикетки принтера (мм). 150×100 = ширина 100, длина подачи 150
# BARCODE_LABEL_WIDTH_MM=100
# BARCODE_LABEL_HEIGHT_MM=150
# BARCODE_LABEL_DPI=300
# Масштаб этикетки (1 = полный размер по центру) и поворот в градусах
# BARCODE_LABEL_SCALE=1
# BARCODE_LABEL_ROTATION=180
# Прямая запись на USB (если lp raw не работает): /dev/usb/lp0
# BARCODE_DEVICE=/dev/usb/lp0

# true — мок-заказы (при deploy сбрасывается прогресс); false — реальный API
USE_MOCK_ORDERS=false

# --- Честный знак (True API ГИС МТ) ---
# PIN доступа к экрану /chestnye-znaki (не PIN USB-токена)
CHESTNY_ZNAK_TEST_PIN=1319
# true только если сайт по HTTPS
# CHESTNY_ZNAK_COOKIE_SECURE=false
# OTPRAVKI_COOKIE_SECURE=false

# True API. Песочница: https://markirovka.sandbox.crptech.ru/api/v3/true-api
CRPT_API_URL=https://markirovka.crpt.ru/api/v3/true-api
CRPT_API_URL_V4=https://markirovka.crpt.ru/api/v4/true-api

# Товарная группа (Casher — lp)
CRPT_PRODUCT_GROUP=lp

# ИНН участника оборота (для списания WRITE_OFF)
# CRPT_INN=212802888026

# Поиск КМ: дата эмиссии «от»
CRPT_SEARCH_EMISSION_FROM=2020-01-01T00:00:00.000Z

# Списание по умолчанию: OTHER | DEFECT | DAMAGE_LOSS
# CRPT_WRITE_OFF_REASON=OTHER
# CRPT_WRITE_OFF_ADDRESS=г. Москва, ...

# Путь к pycades.so на сервере (после сборки)
# PYTHONPATH=/root/pycades/build/src/pycades

# SHA-1 отпечаток сертификата ЭЦП из токена «АНГАРА»
# CRPT_CERT_THUMBPRINT=ABCD1234...

# PIN USB-токена «АНГАРА» (не путать с CHESTNY_ZNAK_TEST_PIN)
# CRPT_TOKEN_PIN=12345678

# Опционально: ИНН для simpleSignIn
# CRPT_INN=7700000000
