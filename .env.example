# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# API-ключ админки (Bearer). Лучше CASHER_API_KEY — надёжнее в production
CASHER_API_KEY=csh_at_...
# api=csh_at_...

# API заказов
ORDERS_API_URL=https://api.cashercollection.com

# Внешний API товаров (картинки, размеры)
PRODUCTS_API_URL=https://api.cashercollection.com

# TTL кэша товаров на сервере, мс (5 мин)
PRODUCTS_CACHE_TTL_MS=300000

# Куда пересылать события сборки/отправки (оставьте пустым — только локальный лог)
# SYNC_API_URL=https://your-backend.example.com

# Папка для кэша и логов синхронизации (на Debian задаётся deploy.sh)
# DATA_DIR=/opt/otpravki/data

# Опционально: принудительно указать принтер (иначе ищется автоматически)
# BARCODE_PRINTER=OtpravkiLabel

# Размер этикетки принтера (мм), по умолчанию 100×150
# BARCODE_LABEL_WIDTH_MM=100
# BARCODE_LABEL_HEIGHT_MM=150
# BARCODE_LABEL_DPI=203
# Масштаб этикетки (0.5 = в два раза меньше) и поворот в градусах
# BARCODE_LABEL_SCALE=0.5
# BARCODE_LABEL_ROTATION=180
# Прямая запись на USB (если lp raw не работает): /dev/usb/lp0
# BARCODE_DEVICE=/dev/usb/lp0

# true — мок-заказы (при deploy сбрасывается прогресс); false — реальный API
USE_MOCK_ORDERS=false
