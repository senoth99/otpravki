# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# API-ключ админки (Bearer). Лучше CASHER_API_KEY — надёжнее в production
CASHER_API_KEY=csh_at_...
# api=csh_at_...

# API заказов
ORDERS_API_URL=https://api.cashercollection.com

# Внешний API товаров (картинки, размеры)
PRODUCTS_API_URL=https://api.cashercollection.com

# TTL кэша товаров на сервере, мс (5 мин)
PRODUCTS_CACHE_TTL_MS=300000

# Картинки отдаются через /api/images/... (прокси с PRODUCTS_API_URL, без локальной скачки)

# Куда пересылать события сборки/отправки (оставьте пустым — только локальный лог)
# SYNC_API_URL=https://your-backend.example.com

# Папка для кэша и логов синхронизации (на Debian задаётся deploy.sh)
# DATA_DIR=/opt/otpravki/data

# Опционально: принудительно указать принтер (иначе ищется автоматически)
# BARCODE_PRINTER=OtpravkiLabel

# Размер этикетки принтера (мм), по умолчанию 100×150
# BARCODE_LABEL_WIDTH_MM=100
# BARCODE_LABEL_HEIGHT_MM=150
# BARCODE_LABEL_DPI=203
# Масштаб этикетки (1 = полный размер по центру) и поворот в градусах
# BARCODE_LABEL_SCALE=1
# BARCODE_LABEL_ROTATION=180
# Прямая запись на USB (если lp raw не работает): /dev/usb/lp0
# BARCODE_DEVICE=/dev/usb/lp0

# true — мок-заказы (при deploy сбрасывается прогресс); false — реальный API
USE_MOCK_ORDERS=false

# --- Честный знак (True API ГИС МТ) ---
# PIN доступа к модулю в приложении (тест)
CHESTNY_ZNAK_TEST_PIN=1319
# URL True API
CRPT_API_URL=https://markirovka.crpt.ru/api/v3/true-api
# SHA-1 отпечаток сертификата на токене АНГАРА
CRPT_CERT_THUMBPRINT=
# PIN USB-токена (не путать с CHESTNY_ZNAK_TEST_PIN)
CRPT_TOKEN_PIN=
# ИНН организации (опционально для simpleSignIn)
CRPT_INN=

# --- Честные знаки (True API ГИС МТ, тестовый режим) ---
# PIN доступа к экрану /chestnye-znaki (не PIN USB-токена)
CHESTNY_ZNAK_TEST_PIN=1319

# True API (продакшн). Песочница: https://markirovka.sandbox.crptech.ru/api/v3/true-api
CRPT_API_URL=https://markirovka.crpt.ru/api/v3/true-api

# SHA-1 отпечаток сертификата ЭЦП из токена «АНГАРА» (хранилище «Личные»)
# CRPT_CERT_THUMBPRINT=ABCD1234...

# PIN USB-токена «АНГАРА» (СКЗИ, не путать с CHESTNY_ZNAK_TEST_PIN)
# CRPT_TOKEN_PIN=12345678

# Опционально: ИНН организации для simpleSignIn
# CRPT_INN=7700000000

# Корень репозитория на сервере (deploy.sh задаёт автоматически)
# APP_DIR=/root/otpravki
